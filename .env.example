# RPC endpoints (also exposed as aliases in foundry.toml [rpc_endpoints])
MAINNET_RPC=
BASE_RPC=
OPTIMISM_RPC=
ARBITRUM_RPC=
INK_RPC=
SEPOLIA_RPC=

# Single RPC for one-off scripts (token / converter deploys)
RPC_URL=

# Block explorer API keys (used by --verify)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# Deployer: name of the encrypted keystore account.
# Import once with: cast wallet import <name> --interactive
# Used by deploy scripts via: forge script ... --account $DEPLOYER_NAME
DEPLOYER_NAME=

# Token deploy (SUPRTokenV2Deploy / LobsterTokenDeploy)
# GOVERNOR_ADDRESS  : address that owns the token after deployment (required)
# BASE_TOKEN_ADDRESS: canonical ERC20 to wrap in a lockbox (optional; empty = no lockbox)
# IS_NATIVE_GAS_TOKEN: true to wrap the chain's native gas token instead of an ERC20 (optional)
GOVERNOR_ADDRESS=
BASE_TOKEN_ADDRESS=
IS_NATIVE_GAS_TOKEN=

# Converter deploy (SUPRConverterDeploy) — addresses of the three already-deployed tokens
OLD_TOKEN_ADDRESS=
NEW_TOKEN_ADDRESS=
BUILD_TOKEN_ADDRESS=
