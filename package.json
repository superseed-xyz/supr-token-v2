{
  "name": "supr-token-v2",
  "version": "1.0.1",
  "private": true,
  "description": "Superseed V2 token (SUPR) — a cross-chain xERC20 (EIP-7281) with per-bridge rate limits, a deterministic CREATE3 factory, and a one-way V1→V2 migrator.",
  "homepage": "https://github.com/superseed-xyz/supr-token-v2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superseed-xyz/supr-token-v2.git"
  },
  "license": "MIT",
  "author": "Superseed",
  "scripts": {
    "build": "forge build",
    "build:optimized": "FOUNDRY_PROFILE=optimized forge build",
    "coverage": "forge coverage --report summary --report lcov --match-path 'solidity/test/unit/*'",
    "deploy:token": "bash -c 'source .env && forge script SUPRTokenV2Deploy --rpc-url $RPC_URL --account $DEPLOYER_NAME --broadcast --verify --slow -vvvv'",
    "deploy:lobster-token": "bash -c 'source .env && forge script LobsterTokenDeploy --rpc-url $RPC_URL --account $DEPLOYER_NAME --broadcast --verify --slow -vvvv'",
    "deploy:converter": "bash -c 'source .env && forge script SUPRConverterDeploy --rpc-url $RPC_URL --account $DEPLOYER_NAME --broadcast --verify -vvvv'",
    "lint:check": "yarn lint:sol-tests && yarn lint:sol-logic && forge fmt --check",
    "lint:fix": "sort-package-json && forge fmt && yarn lint:sol-tests --fix && yarn lint:sol-logic --fix",
    "lint:natspec": "npx @defi-wonderland/natspec-smells --config natspec-smells.config.js",
    "lint:sol-logic": "solhint 'solidity/contracts/**/*.sol' 'solidity/interfaces/**/*.sol'",
    "lint:sol-tests": "solhint -c .solhint.tests.json 'solidity/test/**/*.sol'",
    "postinstall": "forge install",
    "prepare": "husky install",
    "test": "forge test -vvv",
    "test:integration": "forge test --match-contract Integration -vvv",
    "test:invariants": "forge test --match-contract Invariant -vvv",
    "test:unit": "forge test --match-contract Unit -vvv",
    "test:unit:deep": "FOUNDRY_FUZZ_RUNS=5000 yarn test:unit"
  },
  "lint-staged": {
    "*.{js,css,md,ts,sol}": "forge fmt",
    "*.sol": "solhint --fix 'solidity/**/*.sol'",
    "package.json": "sort-package-json"
  },
  "devDependencies": {
    "@commitlint/cli": "17.0.3",
    "@commitlint/config-conventional": "17.0.3",
    "@defi-wonderland/natspec-smells": "1.1.5",
    "cross-env": "7.0.3",
    "husky": ">=8",
    "lint-staged": "13.2.2",
    "solhint": "3.5.1",
    "solhint-plugin-defi-wonderland": "1.1.0",
    "sort-package-json": "1.53.1"
  }
}
